#!/bin/sh /etc/rc.common

START=98
STOP=10
USE_PROCD=1

BIN=/mnt/bitcoin-node/runtime/node-dashboard

start_service() {
    [ -x "$BIN" ] || return 1
    [ -c /dev/fb0 ] || return 1

    # Node mode owns the console. The compositor is intentionally not kept
    # resident beside this low-memory direct-fbdev dashboard.
    /etc/init.d/bmc-compositor stop >/dev/null 2>&1 || true

    procd_open_instance
    procd_set_param command "$BIN" /dev/fb0
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
